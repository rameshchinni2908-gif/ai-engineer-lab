# AI Engineer Lab — environment configuration
#
# IMPORTANT: the app MUST run fully in Mock mode with ZERO API keys set.
# Copy this file to `.env` and only fill in keys for providers you actually
# want to call for real. Never commit a real `.env` file.

NODE_ENV=development
PORT=8787
WEB_PORT=5173

# mock | anthropic | openai | ollama
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# memory | qdrant
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333

DATABASE_PATH=./data/lab.db

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info
