# AI Engineer Lab — environment configuration
#
# IMPORTANT: the app MUST run fully in Mock mode with ZERO API keys set.
# Copy this file to `.env` and only fill in keys for providers you actually
# want to call for real. Never commit a real `.env` file.

NODE_ENV=development
PORT=8787
WEB_PORT=5173

# Browser origin allowed by the API's CORS policy. Scoped deliberately: the API must never
# reflect an arbitrary origin. Defaults to http://localhost:5173 when unset.
WEB_ORIGIN=http://localhost:5173

# mock | anthropic | openai | ollama
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# memory | qdrant
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333

DATABASE_PATH=./data/lab.db

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info

# --- docker compose only -----------------------------------------------------
# docker-compose.yml sets its own container-to-container defaults for most of
# the variables above (e.g. DATABASE_PATH becomes /app/data/lab.db). These two
# are the ones worth knowing about if you copy this file to `.env` before
# running `docker compose up` (compose auto-loads a root `.env`):
#
# WEB_HOST_PORT    which HOST port the web container's nginx (container port
#                  80) is published on. Defaults to 8080, NOT 5173 - on many
#                  machines (notably Docker Desktop on Windows) 5173 is
#                  already bound by the Desktop app's own wslrelay process.
# WEB_ORIGIN       passed to the `api` container's CORS check. Must match
#                  the ORIGIN THE BROWSER ACTUALLY USES, i.e.
#                  http://localhost:<WEB_HOST_PORT> - defaults to
#                  http://localhost:8080 to match WEB_HOST_PORT's default.
#                  If you override WEB_HOST_PORT, override this to match or
#                  every API call will be rejected by CORS.
# WEB_HOST_PORT=8080
# WEB_ORIGIN=http://localhost:8080
